{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "aiwatcher chart values",
  "description": "Deliberately partial. It pins the fields where a typo produces a plausible-looking deployment that quietly does the wrong thing \u2014 the three-way modes, the bus, the log format \u2014 and leaves the rest to the templates, which fail with their own messages.",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "bus": {
          "enum": [
            "memory",
            "wal",
            "laser"
          ]
        },
        "logFormat": {
          "enum": [
            "json",
            "pretty"
          ]
        },
        "ingestEnabled": {
          "type": "boolean"
        },
        "maxRuns": {
          "type": "integer",
          "minimum": 1
        },
        "maxSpansTotal": {
          "type": "integer",
          "minimum": 1
        },
        "orphanTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "corsOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "description": "none | oidc | proxy. `proxy` trusts request headers and therefore the network; see ADR_0013.",
          "enum": [
            "none",
            "oidc",
            "proxy"
          ]
        },
        "roles": {
          "type": "object",
          "properties": {
            "adminGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "editorGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "viewerGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requiredGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "defaultRole": {
              "description": "What an authenticated user in none of the mapped groups gets. `none` requires a group to see anything at all.",
              "enum": [
                "viewer",
                "editor",
                "admin",
                "none"
              ]
            }
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sessionTtlSeconds": {
              "type": "integer",
              "minimum": 60
            }
          }
        }
      }
    },
    "collector": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "install",
            "external",
            "none"
          ]
        },
        "redactPrompts": {
          "type": "boolean"
        }
      }
    },
    "victoriatraces": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "install",
            "external",
            "none"
          ]
        }
      }
    },
    "victoriametrics": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "install",
            "external",
            "none"
          ]
        }
      }
    },
    "panel": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "flow": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "promptStore": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "install",
            "external",
            "none"
          ]
        }
      }
    },
    "engine": {
      "type": "object",
      "properties": {
        "mode": {
          "description": "none | flyte. Unset, every /api/v1/engine route answers 501 naming the variable. See ADR_0016.",
          "enum": [
            "none",
            "flyte"
          ]
        },
        "flyte": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "description": "The control plane's base URL. Required when mode is flyte, and the only place an engine target may come from."
            },
            "project": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "consoleUrl": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "tokenUrl": {
              "type": "string",
              "description": "Explicit rather than discovered \u2014 see ADR_0016."
            },
            "scopes": {
              "type": "string"
            },
            "credentialsSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "clientSecretKey": {
                  "type": "string"
                },
                "tokenKey": {
                  "type": "string"
                }
              }
            }
          }
        },
        "rerun": {
          "description": "none | engine. Whether the Workflows tab\u2019s rerun is dispatched through the engine configured above.",
          "enum": [
            "none",
            "engine"
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowIngressFrom": {
          "type": "array"
        },
        "allowEgressToExternalVictoriaMetrics": {
          "type": "boolean"
        },
        "allowEgressToExternalVictoriaTraces": {
          "type": "boolean"
        }
      }
    }
  }
}
