{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "panel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/panel",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "dev",
      "runtimeExecutable": "just",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "curation-demo",
      "runtimeExecutable": "just",
      "runtimeArgs": [
        "pii-demo"
      ],
      "port": 5173
    },
    {
      "name": "bench-curation",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "AIWATCHER_DATA_DIR=\"${TMPDIR:-/tmp}/aiwatcher-bench-data\" AIWATCHER_BENCH_API_PORT=8095 AIWATCHER_BENCH_PANEL_PORT=5180 just bench-curation-serve 1GB"
      ],
      "port": 5180
    }
  ]
}
