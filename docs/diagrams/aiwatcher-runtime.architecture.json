  "cards": [
    {
      "dot": "cyan",
      "title": "One log, many folds",
      "items": [
        "Ids are derived, so a redelivery lands on the same span",
        "An event is not a span: hundreds fold into a handful",
        "eval.*, workflow.* and execution.* form no span at all"
      ]
    },
    {
      "dot": "emerald",
      "title": "Owned execution",
      "items": [
        "decide is pure; time arrives in Now and ids are derived",
        "The outbox publishes facts after the decision commits",
        "A process claims only the runtimes it registered an executor for"
      ]
    },
    {
      "dot": "violet",
      "title": "Authored, not observed",
      "items": [
        "A prompt version stays readable after its run is evicted",
        "Conversation content is sealed and separately retained",
        "A promotion is refused without a held-out score"
      ]
    }
  ]
