    { "id": "bus", "type": "messagebus", "label": "Durable log", "sublabel": "WAL or Laser" },
    { "id": "pipeline", "type": "backend", "label": "Projector", "sublabel": "dedup + fold" },
    { "id": "traces", "type": "database", "label": "VictoriaTraces", "sublabel": "finished spans" },
