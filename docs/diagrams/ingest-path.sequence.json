    "quality_profile": "showcase",
    "views": [
      { "id": "publish", "label": "Publishing", "focus": ["agent", "api", "bus"], "note": "The agent is answered before anything is folded — telemetry never takes it down." },
      { "id": "fold", "label": "Folding", "focus": ["bus", "pipeline", "traces"], "note": "Hundreds of events become a handful of spans, written before the checkpoint moves." },
      { "id": "resume", "label": "Closing a gap", "focus": ["pipeline", "panel", "api"], "note": "Every frame carries its checkpoint, so a reconnect closes its own gap." }
    ]
  },
  "participants": [
