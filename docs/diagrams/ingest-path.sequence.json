{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "One event, end to end",
    "subtitle": "What an agent publishes, and how it reaches a browser",
    "viewBox": [1080, 560],
    "column_fit": "spread",
    "visual_preset": "signal-flow",
