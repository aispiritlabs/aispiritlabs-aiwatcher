    { "participant": "bus", "from": 220, "to": 372, "type": "messagebus" },
    { "participant": "pipeline", "from": 263, "to": 412, "type": "backend" },
    { "participant": "traces", "from": 300, "to": 339, "type": "database" },
    { "participant": "panel", "from": 400, "to": 446, "type": "frontend" }
  ],
  "cards": [
    { "dot": "emerald", "title": "The agent is never the casualty", "items": ["The transport swallows and counts; a failure is a metric", "The answer comes before any folding happens", "Registry clients are the opposite and raise — that is the work"] },
    { "dot": "rose", "title": "One ordering carries the contract", "items": ["The span is written, then the checkpoint moves", "Reverse it and a crash is silent data loss", "That single line is the at-least-once guarantee"] },
    { "dot": "cyan", "title": "A redelivery is not a duplicate", "items": ["TraceId::derive is a pure function of run and span key", "So the same event twice lands on the same span", "Never replace a derivation with a UUID"] }
  ]
}
