  "cards": [
    {
      "dot": "cyan",
      "title": "Three ways to not be running",
      "items": [
        "Pending waits on this system: a parent, a worker, a delay",
        "AwaitingInput waits on a person, and keeps its claim row",
        "Paused is the run's state, never a step's"
      ]
    },
    {
      "dot": "rose",
      "title": "Failed is not Crashed",
      "items": [
        "Failed: the work ran and gave a wrong answer",
        "Crashed: a node was drained, a lease expired",
        "Both retry; Transient keeps ten attempts, these three"
      ]
    },
    {
      "dot": "emerald",
      "title": "What may be pressed",
      "items": [
        "Retry, only from Failed or Crashed",
        "and never while the run is cancelling",
        "Cancelled is reachable from all four non-terminal states"
      ]
    }
  ]
