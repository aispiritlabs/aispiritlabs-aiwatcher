  "cards": [
    {
      "dot": "cyan",
      "title": "One query, three boxes",
      "items": [
        "A source and every transform behind it compile to one Flow query",
        "So three blocks light up together from one step.started",
        "A transform behind a notebook or a gate is refused by name"
      ]
    },
    {
      "dot": "rose",
      "title": "Why a notebook exists at all",
      "items": [
        "A query composes values and never reaches arbitrary code",
        "Detecting personal data needs something that reads the text",
        "The notebook is one file doing two jobs: a step, and a live app"
      ]
    },
    {
      "dot": "emerald",
      "title": "The gate is in the chain, not the data",
      "items": [
        "It reads the rows before it and produces nothing",
        "Answering is its completion",
        "So the next block binds to a step that is not its parent"
      ]
    }
  ]
