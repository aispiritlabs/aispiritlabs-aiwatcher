{
  "name": "curation/titanic-from-scratch",
  "description": "Titanic from raw passengers to a held-out Random Forest baseline, with thematic data curation blocks and FlowAI encoders.",
  "blocks": [
    {
      "id": "passengers",
      "title": "Titanic \u00b7 raw passengers",
      "position": {
        "x": 0,
        "y": 0
      },
      "spec": {
        "kind": "source",
        "dataset": "hub_rows",
        "arguments": {
          "dataset": "phihung/titanic",
          "split": "train",
          "limit": "891"
        }
      }
    },
    {
      "id": "columns",
      "title": "Select raw columns",
      "position": {
        "x": 270,
        "y": 0
      },
      "spec": {
        "kind": "transform",
        "steps": "->withEntry('PassengerId', array_get(ref('row'), 'PassengerId'))\n->withEntry('Survived', array_get(ref('row'), 'Survived'))\n->withEntry('Pclass', array_get(ref('row'), 'Pclass'))\n->withEntry('Name', array_get(ref('row'), 'Name'))\n->withEntry('Sex', array_get(ref('row'), 'Sex'))\n->withEntry('Age', array_get(ref('row'), 'Age'))\n->withEntry('SibSp', array_get(ref('row'), 'SibSp'))\n->withEntry('Parch', array_get(ref('row'), 'Parch'))\n->withEntry('Ticket', array_get(ref('row'), 'Ticket'))\n->withEntry('Fare', array_get(ref('row'), 'Fare'))\n->withEntry('Cabin', array_get(ref('row'), 'Cabin'))\n->withEntry('Embarked', array_get(ref('row'), 'Embarked'))\n->select(ref('PassengerId'), ref('Survived'), ref('Pclass'), ref('Name'), ref('Sex'), ref('Age'), ref('SibSp'), ref('Parch'), ref('Ticket'), ref('Fare'), ref('Cabin'), ref('Embarked'))"
      }
    },
    {
      "id": "split",
      "title": "Train / validation split",
      "position": {
        "x": 540,
        "y": 0
      },
      "spec": {
        "kind": "notebook",
        "notebook": "flowai_split",
        "params": {
          "seed": 42,
          "validation_fraction": 0.2
        }
      }
    },
    {
      "id": "missing-values",
      "title": "Missing values",
      "position": {
        "x": 810,
        "y": 0
      },
      "spec": {
        "kind": "notebook",
        "notebook": "flowai_missing_values",
        "params": {}
      }
    },
    {
      "id": "features",
      "title": "Feature engineering",
      "position": {
        "x": 1080,
        "y": 0
      },
      "spec": {
        "kind": "notebook",
        "notebook": "flowai_titanic_features",
        "params": {}
      }
    },
    {
      "id": "visualization",
      "title": "Visualization",
      "position": {
        "x": 0,
        "y": 180
      },
      "spec": {
        "kind": "notebook",
        "notebook": "flowai_visualization",
        "params": {}
      }
    },
    {
      "id": "one-hot",
      "title": "OneHotEncoder",
      "position": {
        "x": 270,
        "y": 180
      },
      "spec": {
        "kind": "notebook",
        "notebook": "flowai_one_hot_encoder",
        "params": {
          "columns": [
            "Sex",
            "Pclass",
            "EmbarkedFilled",
            "Title",
            "Deck",
            "AgeBand",
            "FareBand"
          ],
          "handle_unknown": "ignore"
        }
      }
    },
    {
      "id": "label",
      "title": "LabelEncoder",
      "position": {
        "x": 540,
        "y": 180
      },
      "spec": {
        "kind": "notebook",
        "notebook": "flowai_label_encoder",
        "params": {
          "target": "Survived"
        }
      }
    },
    {
      "id": "model",
      "title": "Model training & evaluation",
      "position": {
        "x": 810,
        "y": 180
      },
      "spec": {
        "kind": "notebook",
        "notebook": "flowai_random_forest",
        "params": {
          "seed": 42,
          "n_estimators": 120
        }
      }
    },
    {
      "id": "publish",
      "title": "Publish predictions",
      "position": {
        "x": 1080,
        "y": 180
      },
      "spec": {
        "kind": "view",
        "dataset": "curation/titanic-from-scratch"
      }
    }
  ],
  "edges": [
    {
      "from": "passengers",
      "to": "columns"
    },
    {
      "from": "columns",
      "to": "split"
    },
    {
      "from": "split",
      "to": "missing-values"
    },
    {
      "from": "missing-values",
      "to": "features"
    },
    {
      "from": "features",
      "to": "visualization"
    },
    {
      "from": "visualization",
      "to": "one-hot"
    },
    {
      "from": "one-hot",
      "to": "label"
    },
    {
      "from": "label",
      "to": "model"
    },
    {
      "from": "model",
      "to": "publish"
    }
  ]
}
