{
  "name": "curation/pii-detection-datafusion",
  "description": "Read a public PII corpus, keep the English rows, mask what a shape detector finds, publish what is left. Written for DataFusion (AW-3): it runs where AIWATCHER_QUERY_ENGINE=datafusion.",
  "blocks": [
    {
      "id": "corpus",
      "title": "Hugging Face",
      "position": {
        "x": 0,
        "y": 0
      },
      "spec": {
        "kind": "source",
        "dataset": "hub_rows",
        "arguments": {
          "dataset": "ai4privacy/pii-masking-200k",
          "split": "train",
          "limit": "50"
        }
      }
    },
    {
      "id": "shape",
      "title": "DataFusion: English text",
      "position": {
        "x": 300,
        "y": 0
      },
      "spec": {
        "kind": "transform",
        "steps": "df.with_column(\"text\", col(\"row\")[\"source_text\"])\n.with_column(\"language\", col(\"row\")[\"language\"])\n.filter(col(\"language\") == lit(\"en\"))\n.select(col(\"row_index\"), col(\"language\"), col(\"text\"))",
        "engine": "datafusion"
      }
    },
    {
      "id": "detect",
      "title": "Python processing",
      "position": {
        "x": 600,
        "y": 0
      },
      "spec": {
        "kind": "notebook",
        "notebook": "pii_detection",
        "params": {
          "text_column": "text",
          "only_matches": false
        }
      }
    },
    {
      "id": "result",
      "title": "View",
      "position": {
        "x": 900,
        "y": 0
      },
      "spec": {
        "kind": "view",
        "dataset": "curation/pii-masked-sample-datafusion"
      }
    }
  ],
  "edges": [
    {
      "from": "corpus",
      "to": "shape"
    },
    {
      "from": "shape",
      "to": "detect"
    },
    {
      "from": "detect",
      "to": "result"
    }
  ]
}
