# Machine-local settings. Copy to `.env`, which is gitignored.
#
# `just` loads this into every recipe (`set dotenv-load := true`) and
# deploy/scripts/install.sh reads it too, so what is in here is what
# `just install-cluster` and a bare `./deploy/scripts/install.sh` both use.
# A variable already exported in your shell wins over the file.

# ── Installing ───────────────────────────────────────────────────────────────

# Which environment file under deploy/environments/ an install uses. `planner`
# is aiwatcher as a guest in planner's namespace on planner's k3s.
AIWATCHER_ENV=planner

# The published images. CI names them after the repository owner — see
# .github/workflows/release-images.yml, which prints these three lines in its
# run summary. The environment files carry `ghcr.io/example/...` placeholders,
# so without these an install pulls something that does not exist.
AIWATCHER_IMAGE=ghcr.io/aispiritlabs/aiwatcher
AIWATCHER_PANEL_IMAGE=ghcr.io/aispiritlabs/aiwatcher-panel
AIWATCHER_FLOW_IMAGE=ghcr.io/aispiritlabs/aiwatcher-flow

# Leave unset and the tag is this checkout's commit, which is what CI tagged the
# images with. Set it to deploy a commit other than the one you have out.
# AIWATCHER_IMAGE_TAG=

# ghcr packages under an organisation are private by default. planner already
# keeps this Secret in its namespace; IMAGE_PULL_SECRET works too, which is the
# name planner's own deploy.sh uses.
AIWATCHER_IMAGE_PULL_SECRET=ghcr-pull

# The Query tab's PHP service. The planner environment already turns it on;
# this is for installing it into any other environment.
# AIWATCHER_FLOW=true

# Publish the panel on this host. Normally unset: an environment that publishes
# at all (planner's does, because it also attaches the middlewares that
# authenticate it) gets its host from detection, derived from what the cluster
# already serves. Set this to name one by hand.
# AIWATCHER_DOMAIN=

# ── Signing in ───────────────────────────────────────────────────────────────
#
# Off unless set. `just run-sso` reads these and runs the server as an OIDC
# relying party against a local authentik (`just authentik-up`); see
# deploy/authentik/README.md for the five minutes of clicking, or the blueprint
# beside it for none.
#
# The issuer is the *application* slug, not the provider name. Getting that
# wrong is the most common failure here and its symptom is a 404 on discovery.
# AIWATCHER_AUTH_MODE=oidc
# AIWATCHER_AUTH_ISSUER=http://localhost:9000/application/o/aiwatcher/
# AIWATCHER_AUTH_CLIENT_ID=aiwatcher
# AIWATCHER_AUTH_CLIENT_SECRET=
# The panel's dev server proxies /api, so the browser sees one origin and this
# is a localhost:5173 URL rather than a :8080 one. It must match the redirect
# URI on the authentik application exactly.
# AIWATCHER_AUTH_REDIRECT_URL=http://localhost:5173/api/v1/auth/callback
# Without this a restart signs everybody out. `openssl rand -hex 32`.
# AIWATCHER_AUTH_SESSION_SECRET=

# How a producer authenticates once the above is on. An agent reaches the
# server directly and cannot complete an interactive sign-in, so it presents a
# shared secret instead — editor, never admin. `name=secret`, comma-separated.
# AIWATCHER_AUTH_INGEST_TOKENS=local=

# ── The pipeline engine ──────────────────────────────────────────────────────
#
# What this instance may list and start: the launch plans an orchestrator
# already holds. Off unless set, and every /api/v1/engine route then answers
# 501 naming this variable — starting work in another system is a decision
# somebody makes rather than one they inherit. See ADR_0016.
# AIWATCHER_ENGINE=flyte

# The control plane, in-cluster. Never an event and never a request body: this
# is the only place an engine target may come from.
# AIWATCHER_FLYTE_ENDPOINT=http://localhost:30080
# AIWATCHER_FLYTE_PROJECT=flytesnacks
# AIWATCHER_FLYTE_DOMAIN=development

# The browser-facing host, for links out of the panel. Usually a different
# address from the one above; empty renders no link rather than a broken one.
# AIWATCHER_FLYTE_CONSOLE_URL=http://localhost:30080

# Credentials, when the control plane has any. Either a pre-issued bearer:
# AIWATCHER_FLYTE_TOKEN=
# …or a service account, all three together. The token endpoint is explicit
# rather than discovered: taking it from a document the control plane serves
# would hand the choice of who mints aiwatcher's credentials to whoever
# answered the request.
# AIWATCHER_FLYTE_CLIENT_ID=aiwatcher
# AIWATCHER_FLYTE_CLIENT_SECRET=
# AIWATCHER_FLYTE_TOKEN_URL=http://localhost:30080/oauth2/token
# AIWATCHER_FLYTE_SCOPES=all

# Whether the Workflows tab's rerun goes through the engine as well. `http`
# posts to AIWATCHER_WORKFLOW_RUNNER_URL instead; `none` leaves it at 501.
# AIWATCHER_WORKFLOW_RUNNER=engine

# ── Dataset hubs ─────────────────────────────────────────────────────────────
#
# What the Datasets area's Discover view searches. Both hubs are off unless set
# and /api/v1/dataset-hubs then answers 501 naming these variables, rather than
# an empty list — an empty search result is a claim about the world, and an
# instance that never searched must not make it. See ADR_0019.
#
# Hugging Face's dataset search is public, so this is a switch rather than a
# credential. `just run-hubs` sets it inline for a single run.
# AIWATCHER_HUGGINGFACE_ENABLED=true

# Optional: the search is public. When set it is sent as a bearer on it, so
# results include what the account can see. HF_TOKEN works too, which is the
# name the Hugging Face CLI writes.
# AIWATCHER_HUGGINGFACE_TOKEN=

# Kaggle needs both halves of one credential — with either missing, Kaggle
# stays off and only Hugging Face is asked. From kaggle.json, which
# KAGGLE_USERNAME/KAGGLE_KEY also spell.
# AIWATCHER_KAGGLE_USERNAME=
# AIWATCHER_KAGGLE_KEY=

# The curated table a hub result is reconciled against: a JSON catalogue
# somebody wrote and dated, loaded from this path. This build ships no rows, so
# with this unset nothing matches and every hub result stays licence-`unclear`
# — which is the safe state, not a degraded one. A mirror's licence field is
# never a permission; the licence at the link is.
# AIWATCHER_DATASET_SOURCES=./dataset-sources.json

# ── The conversation archive ─────────────────────────────────────────────────
#
# Off, and the only setting in this file whose default is chosen so that doing
# nothing keeps nothing. Turning it on means this instance retains what people
# said to your agents — encrypted, on a retention clock of its own, and
# erasable on request. See docs/ADR/ADR_0021_CONVERSATION_ARCHIVE.md.
# AIWATCHER_CONVERSATION_ARCHIVE=on

# Required whenever the archive is on: the server refuses to start without it,
# because an archive with no key is a plaintext archive in a bucket that
# prompts, datasets, annotations and training already read.
#
# `id:key[,id:key]`, active first, each key 32 base64url bytes. Rotate by
# prepending a new one; every listed key can still open what it sealed.
# Generate one with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
# `just run-conversations` writes a development key into ./.data instead. A
# deployment gets this from a secret manager, never from a file beside the data.
# AIWATCHER_CONVERSATION_KEYS=2026-09:...

# `protected` (the default) refuses a turn with no consent record and no
# redaction record, reporting every missing field at once. `open` records the
# gaps instead — and every export then excludes those turns by name, in a
# manifest, forever.
# AIWATCHER_CONVERSATION_POLICY=protected

# The longest retention this deployment will apply. A producer asking for more
# is shortened to this, and the turn records that it was.
# AIWATCHER_CONVERSATION_MAX_TTL_DAYS=365

# Whether the server's own scan refusing content is fatal. Off by default: a
# scanner is a heuristic, and one that rejects a write throws away the only
# copy of an exchange because a hex string looked like a key. A finding always
# blocks the export, which is the gate that matters.
# AIWATCHER_CONVERSATION_REJECT_ON_FINDING=false

# How often the retention sweep runs, and how often the export worker looks for
# a job when nothing has nudged it.
# AIWATCHER_CONVERSATION_SWEEP_SECONDS=3600

# ── Local development ────────────────────────────────────────────────────────

# The cluster Tilt is allowed to touch. A remote context is a hard stop.
# AIWATCHER_K8S_CONTEXT=orbstack

# `base` (write-ahead log) or `laser`.
# AIWATCHER_K8S_OVERLAY=base

# For `just test-laser` and `just run-laser`, against `just iggy-up`.
# AIWATCHER_LASER_CONNECTION_STRING=iggy:iggy@127.0.0.1:8090

# For `just test-rustfs`, against `just rustfs-up`.
# AIWATCHER_PROMPT_S3_ENDPOINT=http://127.0.0.1:9010

# For `just test-pipeline`, which needs nothing running — the fake Flyte admin
# is a loopback socket the test starts itself.
