{
  "starterQuery": [
    "(",
    "    read(\"default\")",
    "    .project(StarExpression(), FunctionExpression(\"unnest\", ColumnExpression(\"agents\")).alias(\"agent\"))",
    "    .aggregate(",
    "        [",
    "            ColumnExpression(\"agent\"),",
    "            FunctionExpression(\"count\", ColumnExpression(\"run_id\")).alias(\"runs\"),",
    "            FunctionExpression(\"sum\", ColumnExpression(\"input_tokens\")).alias(\"input_tokens\"),",
    "        ],",
    "        \"agent\",",
    "    )",
    "    .sort(ColumnExpression(\"runs\").desc())",
    ")"
  ],
  "starterCuration": "production/successful-sessions",
  "newTransform": "df.limit(100)",
  "transformHelp": "Python over df — the rows the blocks before this one produced — ending in a relation, e.g. {example}. The five Expression classes are DuckDB's, and every DuckDB block before the first notebook runs as one query.",
  "transformExample": "df.filter(ColumnExpression(\"status\") == ConstantExpression(\"error\"))",
  "transformations": [
    {
      "label": "Period",
      "code": "read(\"default\", period=\"24h\")",
      "help": "Pin a relative period in the saved recipe."
    },
    {
      "label": "Filter",
      "code": ".filter(ColumnExpression(\"status\") == ConstantExpression(\"succeeded\"))",
      "help": "Keep cases matching a condition."
    },
    {
      "label": "Enrich",
      "code": ".project(StarExpression(), ConstantExpression(\"production\").alias(\"label\"))",
      "help": "Add labels or derived fields: every column, and the new one."
    },
    {
      "label": "Recode",
      "code": ".project(StarExpression(), CaseExpression(ColumnExpression(\"sex\") == ConstantExpression(\"female\"), ConstantExpression(1)).otherwise(ConstantExpression(0)).alias(\"sex_code\"))",
      "help": "Map a category onto a number or a shorter label."
    },
    {
      "label": "Extract",
      "code": ".project(StarExpression(), FunctionExpression(\"regexp_replace\", ColumnExpression(\"name\"), ConstantExpression(r\"^[^,]*, ([^.]+)\\..*$\"), ConstantExpression(r\"\\1\")).alias(\"title\"))",
      "help": "Pull a field out of a string: the replacement is the captured group."
    },
    {
      "label": "Band",
      "code": ".project(StarExpression(), CaseExpression(ColumnExpression(\"age\").isnull(), ConstantExpression(\"unknown\")).when(ColumnExpression(\"age\") < ConstantExpression(13), ConstantExpression(\"child\")).otherwise(ConstantExpression(\"adult\")).alias(\"band\"))",
      "help": "Turn a number into buckets. A CASE takes the first branch that holds, so the null check goes first."
    },
    {
      "label": "Expand",
      "code": ".project(StarExpression(), FunctionExpression(\"unnest\", ColumnExpression(\"agents\")).alias(\"agent\"))",
      "help": "Turn a list into one row per value."
    },
    {
      "label": "Deduplicate",
      "code": ".aggregate([ColumnExpression(\"conversation_id\"), FunctionExpression(\"arg_min\", ColumnExpression(\"run_id\"), ColumnExpression(\"started_at\")).alias(\"run_id\")], \"conversation_id\")",
      "help": "Choose the identity of one case, and which row stands for it."
    },
    {
      "label": "Rename",
      "code": ".project(StarExpression(exclude=[\"run_id\"]), ColumnExpression(\"run_id\").alias(\"source_run_id\"))",
      "help": "Shape the dataset contract."
    },
    {
      "label": "Combine",
      "code": ".filter((ColumnExpression(\"agent_id\") == ConstantExpression(\"a\")) | (ColumnExpression(\"agent_id\") == ConstantExpression(\"b\")))",
      "help": "Match one of several agents or rules."
    },
    {
      "label": "Aggregate",
      "code": ".aggregate([ColumnExpression(\"model\"), FunctionExpression(\"count\", ColumnExpression(\"span_id\")).alias(\"spans\")], \"model\")",
      "help": "Build summaries or grouped cases: the keys and the numbers, then the keys again as the group."
    },
    {
      "label": "Distribution",
      "code": ".aggregate([FunctionExpression(\"median\", ColumnExpression(\"fare\")), FunctionExpression(\"stddev_samp\", ColumnExpression(\"fare\")), FunctionExpression(\"quantile_cont\", ColumnExpression(\"fare\"), ConstantExpression(0.9))])",
      "help": "DuckDB's own. A group too small for a deviation answers null, not zero."
    },
    {
      "label": "Arithmetic",
      "code": ".project(StarExpression(), (ColumnExpression(\"sib_sp\") + ColumnExpression(\"parch\") + ConstantExpression(1)).alias(\"family\"))",
      "help": "Operators on columns, and FunctionExpression(\"round\", …) for a result somebody reads."
    },
    {
      "label": "Window",
      "code": "typical = df.aggregate([ColumnExpression(\"status\").alias(\"status_group\"), FunctionExpression(\"median\", ColumnExpression(\"age\")).alias(\"typical\")], \"status\")",
      "help": "A group's answer beside every row: aggregate, then join it back on the key."
    },
    {
      "label": "Join",
      "code": ".join(other.set_alias(\"other\"), ColumnExpression(\"run_id\") == ColumnExpression(\"run\"), \"left\")",
      "help": "Both sides are relations read through the same catalog. Two reads of one dataset need telling apart: an alias on one side, and a key named differently."
    }
  ],
  "examples": [
    {
      "title": "Successful sessions",
      "name": "production/successful-sessions",
      "dataset": "evaluation/production-sessions",
      "description": "Successful production runs from the last day, the first run of each session.",
      "query": [
        "(",
        "    read(\"default\", period=\"24h\")",
        "    .filter(ColumnExpression(\"status\") == ConstantExpression(\"succeeded\"))",
        "    .aggregate(",
        "        [",
        "            FunctionExpression(\"arg_min\", ColumnExpression(\"run_id\"), ColumnExpression(\"started_at\")).alias(\"source_run_id\"),",
        "            ColumnExpression(\"conversation_id\").alias(\"source_session_id\"),",
        "            FunctionExpression(\"arg_min\", ColumnExpression(\"trace_id\"), ColumnExpression(\"started_at\")).alias(\"source_trace_id\"),",
        "            FunctionExpression(\"arg_min\", ColumnExpression(\"agents\"), ColumnExpression(\"started_at\")).alias(\"agents\"),",
        "            FunctionExpression(\"min\", ColumnExpression(\"started_at\")).alias(\"started_at\"),",
        "        ],",
        "        \"conversation_id\",",
        "    )",
        ")"
      ]
    },
    {
      "title": "Titanic · sex and status",
      "name": "titanic/passengers",
      "dataset": "curation/titanic-passengers",
      "description": "Recode sex, pull the title out of the name and collapse it to a status, band the age, and say what Survived and Embarked mean in words.",
      "query": [
        "(",
        "    read(\"hub_rows\", dataset=\"phihung/titanic\", split=\"train\", limit=100)",
        "    .select(",
        "        ColumnExpression(\"row\", \"Name\").alias(\"name\"),",
        "        ColumnExpression(\"row\", \"Sex\").alias(\"sex\"),",
        "        ColumnExpression(\"row\", \"Age\").alias(\"age\"),",
        "        ColumnExpression(\"row\", \"Pclass\").alias(\"pclass\"),",
        "        ColumnExpression(\"row\", \"Fare\").alias(\"fare\"),",
        "        ColumnExpression(\"row\", \"Embarked\").alias(\"embarked\"),",
        "        ColumnExpression(\"row\", \"Survived\").alias(\"survived\"),",
        "    )",
        "    .project(",
        "        StarExpression(),",
        "        CaseExpression(ColumnExpression(\"sex\") == ConstantExpression(\"female\"), ConstantExpression(1)).otherwise(ConstantExpression(0)).alias(\"sex_code\"),",
        "        FunctionExpression(",
        "            \"regexp_replace\",",
        "            ColumnExpression(\"name\"),",
        "            ConstantExpression(r\"^[^,]*,\\s*([^.]+)\\..*$\"),",
        "            ConstantExpression(r\"\\1\"),",
        "        ).alias(\"title\"),",
        "    )",
        "    .project(",
        "        StarExpression(),",
        "        CaseExpression(ColumnExpression(\"title\") == ConstantExpression(\"Mr\"), ConstantExpression(\"mr\"))",
        "        .when(ColumnExpression(\"title\") == ConstantExpression(\"Master\"), ConstantExpression(\"master\"))",
        "        .when(",
        "            ColumnExpression(\"title\").isin(ConstantExpression(\"Mrs\"), ConstantExpression(\"Mme\")),",
        "            ConstantExpression(\"mrs\"),",
        "        )",
        "        .when(",
        "            ColumnExpression(\"title\").isin(",
        "                ConstantExpression(\"Miss\"), ConstantExpression(\"Mlle\"), ConstantExpression(\"Ms\")",
        "            ),",
        "            ConstantExpression(\"miss\"),",
        "        )",
        "        .otherwise(ConstantExpression(\"rare\")).alias(\"status\"),",
        "        CaseExpression(ColumnExpression(\"survived\") == ConstantExpression(1), ConstantExpression(\"survived\"))",
        "        .otherwise(ConstantExpression(\"died\"))",
        "        .alias(\"outcome\"),",
        "        CaseExpression(ColumnExpression(\"embarked\") == ConstantExpression(\"S\"), ConstantExpression(\"Southampton\"))",
        "        .when(ColumnExpression(\"embarked\") == ConstantExpression(\"C\"), ConstantExpression(\"Cherbourg\"))",
        "        .when(ColumnExpression(\"embarked\") == ConstantExpression(\"Q\"), ConstantExpression(\"Queenstown\"))",
        "        .otherwise(ConstantExpression(\"unknown\"))",
        "        .alias(\"port\"),",
        "        CaseExpression(ColumnExpression(\"age\").isnull(), ConstantExpression(\"unknown\"))",
        "        .when(ColumnExpression(\"age\") < ConstantExpression(13), ConstantExpression(\"child\"))",
        "        .when(ColumnExpression(\"age\") < ConstantExpression(20), ConstantExpression(\"teen\"))",
        "        .when(ColumnExpression(\"age\") < ConstantExpression(60), ConstantExpression(\"adult\"))",
        "        .otherwise(ConstantExpression(\"senior\"))",
        "        .alias(\"age_band\"),",
        "    )",
        "    .select(",
        "        ColumnExpression(\"name\"), ColumnExpression(\"sex\"), ColumnExpression(\"sex_code\"),",
        "        ColumnExpression(\"title\"), ColumnExpression(\"status\"), ColumnExpression(\"age\"),",
        "        ColumnExpression(\"age_band\"), ColumnExpression(\"pclass\"), ColumnExpression(\"fare\"),",
        "        ColumnExpression(\"port\"), ColumnExpression(\"outcome\"),",
        "    )",
        ")"
      ]
    },
    {
      "title": "Titanic · features in one query",
      "name": "titanic/features",
      "dataset": "curation/titanic-features-query",
      "description": "The whole feature engineering as one query: recode, fill a missing age from its status group's median, size the family, and keep the guess distinguishable from the measurement.",
      "query": [
        "passengers = (",
        "    read(\"hub_rows\", dataset=\"phihung/titanic\", split=\"train\", limit=100)",
        "    .select(",
        "        ColumnExpression(\"row\", \"Name\").alias(\"name\"),",
        "        ColumnExpression(\"row\", \"Sex\").alias(\"sex\"),",
        "        ColumnExpression(\"row\", \"Age\").alias(\"age\"),",
        "        ColumnExpression(\"row\", \"SibSp\").alias(\"sib_sp\"),",
        "        ColumnExpression(\"row\", \"Parch\").alias(\"parch\"),",
        "        ColumnExpression(\"row\", \"Fare\").alias(\"fare\"),",
        "    )",
        "    .project(",
        "        StarExpression(),",
        "        CaseExpression(ColumnExpression(\"sex\") == ConstantExpression(\"female\"), ConstantExpression(1)).otherwise(ConstantExpression(0)).alias(\"sex_code\"),",
        "        FunctionExpression(",
        "            \"regexp_replace\",",
        "            ColumnExpression(\"name\"),",
        "            ConstantExpression(r\"^[^,]*,\\s*([^.]+)\\..*$\"),",
        "            ConstantExpression(r\"\\1\"),",
        "        ).alias(\"title\"),",
        "    )",
        "    .project(StarExpression(), CaseExpression(ColumnExpression(\"title\") == ConstantExpression(\"Mr\"), ConstantExpression(\"mr\"))",
        "        .when(ColumnExpression(\"title\") == ConstantExpression(\"Master\"), ConstantExpression(\"master\"))",
        "        .when(",
        "            ColumnExpression(\"title\").isin(ConstantExpression(\"Mrs\"), ConstantExpression(\"Mme\")),",
        "            ConstantExpression(\"mrs\"),",
        "        )",
        "        .when(",
        "            ColumnExpression(\"title\").isin(",
        "                ConstantExpression(\"Miss\"), ConstantExpression(\"Mlle\"), ConstantExpression(\"Ms\")",
        "            ),",
        "            ConstantExpression(\"miss\"),",
        "        )",
        "        .otherwise(ConstantExpression(\"rare\")).alias(\"status\"))",
        ")",
        "typical = passengers.aggregate(",
        "    [",
        "        ColumnExpression(\"status\").alias(\"status_group\"),",
        "        FunctionExpression(\"median\", ColumnExpression(\"age\")).alias(\"typical_age\"),",
        "    ],",
        "    \"status\",",
        ").set_alias(\"typical\")",
        "(",
        "    passengers.join(typical, ColumnExpression(\"status\") == ColumnExpression(\"status_group\"), \"left\")",
        "    .project(",
        "        StarExpression(),",
        "        ColumnExpression(\"age\").isnull().alias(\"age_imputed\"),",
        "        CaseExpression(ColumnExpression(\"age\").isnull(), ColumnExpression(\"typical_age\"))",
        "        .otherwise(ColumnExpression(\"age\"))",
        "        .alias(\"age_filled\"),",
        "        (ColumnExpression(\"sib_sp\") + ColumnExpression(\"parch\") + ConstantExpression(1))",
        "        .alias(\"family_size\"),",
        "    )",
        "    .project(",
        "        StarExpression(),",
        "        (ColumnExpression(\"family_size\") == ConstantExpression(1)).alias(\"is_alone\"),",
        "        FunctionExpression(",
        "            \"round\", ColumnExpression(\"fare\") / ColumnExpression(\"family_size\"), ConstantExpression(2)",
        "        ).alias(\"fare_per_person\"),",
        "    )",
        "    .select(",
        "        ColumnExpression(\"name\"), ColumnExpression(\"status\"), ColumnExpression(\"sex_code\"),",
        "        ColumnExpression(\"age\"), ColumnExpression(\"age_filled\"), ColumnExpression(\"age_imputed\"),",
        "        ColumnExpression(\"family_size\"), ColumnExpression(\"is_alone\"),",
        "        ColumnExpression(\"fare_per_person\"),",
        "    )",
        ")"
      ]
    },
    {
      "title": "Titanic · age and fare spread",
      "name": "titanic/age-and-fare",
      "dataset": "curation/titanic-age-and-fare",
      "description": "Median, deviation and a 90th percentile per class — the half of describe() a mean leaves out, all of it DuckDB’s own.",
      "query": [
        "(",
        "    read(\"hub_rows\", dataset=\"phihung/titanic\", split=\"train\", limit=100)",
        "    .select(",
        "        ColumnExpression(\"row\", \"Pclass\").alias(\"pclass\"),",
        "        ColumnExpression(\"row\", \"Age\").alias(\"age\"),",
        "        ColumnExpression(\"row\", \"Fare\").alias(\"fare\"),",
        "    )",
        "    .aggregate(",
        "        [",
        "            ColumnExpression(\"pclass\"),",
        "            FunctionExpression(\"count\", ColumnExpression(\"pclass\")).alias(\"passengers\"),",
        "            FunctionExpression(\"avg\", ColumnExpression(\"age\")).alias(\"mean_age\"),",
        "            FunctionExpression(\"median\", ColumnExpression(\"age\")).alias(\"age_median\"),",
        "            FunctionExpression(",
        "                \"round\", FunctionExpression(\"stddev_samp\", ColumnExpression(\"age\")), ConstantExpression(2)",
        "            ).alias(\"age_spread\"),",
        "            FunctionExpression(\"median\", ColumnExpression(\"fare\")).alias(\"fare_median\"),",
        "            FunctionExpression(",
        "                \"quantile_cont\", ColumnExpression(\"fare\"), ConstantExpression(0.9)",
        "            ).alias(\"fare_p90\"),",
        "        ],",
        "        \"pclass\",",
        "    )",
        "    .sort(ColumnExpression(\"pclass\").asc())",
        ")"
      ]
    },
    {
      "title": "Titanic · survival by status",
      "name": "titanic/survival-by-status",
      "dataset": "curation/titanic-survival-by-status",
      "description": "Survival rate and headcount by status and class, sorted by rate. The first table every Titanic notebook draws.",
      "query": [
        "(",
        "    read(\"hub_rows\", dataset=\"phihung/titanic\", split=\"train\", limit=100)",
        "    .select(",
        "        ColumnExpression(\"row\", \"Name\").alias(\"name\"),",
        "        ColumnExpression(\"row\", \"Sex\").alias(\"sex\"),",
        "        ColumnExpression(\"row\", \"Pclass\").alias(\"pclass\"),",
        "        ColumnExpression(\"row\", \"Survived\").alias(\"survived\"),",
        "    )",
        "    .project(StarExpression(), FunctionExpression(",
        "            \"regexp_replace\",",
        "            ColumnExpression(\"name\"),",
        "            ConstantExpression(r\"^[^,]*,\\s*([^.]+)\\..*$\"),",
        "            ConstantExpression(r\"\\1\"),",
        "        ).alias(\"title\"))",
        "    .project(StarExpression(), CaseExpression(ColumnExpression(\"title\") == ConstantExpression(\"Mr\"), ConstantExpression(\"mr\"))",
        "        .when(ColumnExpression(\"title\") == ConstantExpression(\"Master\"), ConstantExpression(\"master\"))",
        "        .when(",
        "            ColumnExpression(\"title\").isin(ConstantExpression(\"Mrs\"), ConstantExpression(\"Mme\")),",
        "            ConstantExpression(\"mrs\"),",
        "        )",
        "        .when(",
        "            ColumnExpression(\"title\").isin(",
        "                ConstantExpression(\"Miss\"), ConstantExpression(\"Mlle\"), ConstantExpression(\"Ms\")",
        "            ),",
        "            ConstantExpression(\"miss\"),",
        "        )",
        "        .otherwise(ConstantExpression(\"rare\")).alias(\"status\"))",
        "    .aggregate(",
        "        [",
        "            ColumnExpression(\"status\"),",
        "            ColumnExpression(\"sex\"),",
        "            ColumnExpression(\"pclass\"),",
        "            FunctionExpression(\"count\", ColumnExpression(\"survived\")).alias(\"passengers\"),",
        "            FunctionExpression(\"avg\", ColumnExpression(\"survived\")).alias(\"survival_rate\"),",
        "        ],",
        "        \"status, sex, pclass\",",
        "    )",
        "    .sort(ColumnExpression(\"survival_rate\").desc())",
        ")"
      ]
    }
  ]
}
