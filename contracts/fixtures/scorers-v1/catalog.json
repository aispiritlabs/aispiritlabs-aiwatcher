{
  "contract": 1,
  "adapters": [
    {
      "name": "deepeval",
      "version": "4.2.2",
      "model": {"name": "gemma-4-e2b", "version": "ud-q4-k-xl"},
      "metrics": [
        {
          "metric": "answer_relevancy",
          "description": "How much of the answer is relevant to what was asked.",
          "unit": "score",
          "direction": "higher",
          "aggregation": "mean",
          "reads": ["input", "answer"],
          "model_graded": true,
          "range": [0.0, 1.0]
        },
        {
          "metric": "pattern_match",
          "description": "The whole answer matches the pattern.",
          "unit": "ratio",
          "direction": "higher",
          "aggregation": "rate",
          "reads": ["answer"],
          "model_graded": false,
          "parameters": {
            "ignore_case": {"kind": "boolean", "required": false},
            "pattern": {"kind": "string", "required": true}
          }
        }
      ]
    }
  ]
}
